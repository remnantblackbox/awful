\ BST simple implementation

\ Each node is defined as a triple [value, left, right] where left and right can be represented
\ as other nodes like [value, [value, nil, nil], [value, nil, nil]]
letrec

node = fun v l r: [v, l, r],

value = fun t: 1st t,

left = fun t: 1st rest t,

right = fun t: 1st rest rest t,

\ search(t, v) = search value v in tree t, returns 1 if found or 0 if not found
search = fun t v:
    if empty t then 0
        else
    if value(t) > v then search(left(t), v)
        else
    if value(t) < v then search(right(t), v)
        else
    value(t) = v,

\ tree traversal functions - my brain is lost in recursion

preorder = fun t s:
    if empty t then s
        else
    value(t) : preorder(left(t), preorder(right(t), s)),
    
inorder = fun t s:
    if empty t then s
        else
    inorder(left(t), value(t) : inorder(right(t), s)),

postorder = fun t s:
    if empty t then s
        else
    postorder(left(t), postorder(right(t), value(t) : s))

in postorder([5, [2, [1, nil, nil], [3, nil, nil]], [8, nil, [9, nil, nil]]], nil)


